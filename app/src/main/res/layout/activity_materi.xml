<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bggradiens"
    tools:context=".MateriActivity">

<GridLayout
    android:layout_width="0dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    android:layout_margin="10dp"
    android:columnCount="2"
    android:rowCount="3"
    android:layout_height="0dp">

    <androidx.cardview.widget.CardView
        android:layout_height="0dp"
        android:layout_width="0dp"
        app:cardCornerRadius="15dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        app:cardElevation="0dp"
        android:layout_margin="5dp"
        app:cardBackgroundColor="@color/white">
<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <ImageView
        android:id="@+id/metper"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_centerInParent="true"
        android:src="@drawable/maintenance"></ImageView>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/metper"
        android:text="Metode Perawatan"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_centerHorizontal="true">

    </TextView>
</RelativeLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:layout_height="0dp"
        android:layout_width="0dp"
        app:cardCornerRadius="15dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        app:cardElevation="0dp"
        android:layout_margin="5dp"
        app:cardBackgroundColor="@color/white">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/perhard"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_centerInParent="true"
                android:src="@drawable/hardware"></ImageView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/perhard"
                android:text="Perawatan Hardware dan SoftWare"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_centerHorizontal="true">

            </TextView>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_height="0dp"
        android:layout_width="0dp"
        app:cardCornerRadius="15dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        app:cardElevation="0dp"
        android:layout_margin="5dp"
        app:cardBackgroundColor="@color/white">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/cleaning"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_centerInParent="true"
                android:src="@drawable/cleaning"></ImageView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/cleaning"
                android:text="Pembersihan Komponen"
                android:textStyle="bold"
                android:textColor="@color/black"

                android:layout_centerHorizontal="true">

            </TextView>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:layout_height="0dp"
        android:layout_width="0dp"
        app:cardCornerRadius="15dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        app:cardElevation="0dp"
        android:layout_margin="5dp"
        app:cardBackgroundColor="@color/white">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/toolkit"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_centerInParent="true"
                android:src="@drawable/toolbox"></ImageView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/toolkit"
                android:text="Alat Perawatan"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_centerHorizontal="true">

            </TextView>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:layout_height="0dp"
        android:layout_width="0dp"
        app:cardCornerRadius="15dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        app:cardElevation="0dp"
        android:layout_margin="5dp"
        app:cardBackgroundColor="@color/white">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/prosedur"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_centerInParent="true"
                android:src="@drawable/process"></ImageView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/prosedur"
                android:text="Prosedur Perawatan"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_centerHorizontal="true">
            </TextView>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:layout_height="0dp"
        android:layout_width="0dp"
        app:cardCornerRadius="15dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        app:cardElevation="0dp"
        android:layout_margin="5dp"
        app:cardBackgroundColor="@color/white">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/trouble"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_centerInParent="true"
                android:src="@drawable/troubleshooting"></ImageView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/trouble"
                android:text="troubleshooting"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_centerHorizontal="true">

            </TextView>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>




</GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>